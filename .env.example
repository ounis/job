# Copy this file to ".env" and fill in the values.

# --- AI provider ---
# AI_PROVIDER: "openai" (cloud, needs key) or "ollama" (local, free, no key).
AI_PROVIDER=openai
# OpenAI cloud:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama (local): install ollama, run `ollama pull llama3.1`, set AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# --- Job data providers ---
# JSearch (RapidAPI) — broad aggregator: pulls from Google for Jobs (LinkedIn,
# Indeed, Glassdoor, company pages, ...). Subscribe (free tier available) at
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch and paste the key here.
RAPIDAPI_KEY=
# Pages fetched per JSearch query (~10 results/page). Free tier allows 1.
# Raise only if your paid plan permits more pages.
JSEARCH_MAX_PAGES=1

# Adzuna (https://developer.adzuna.com/) — free app id + key. Also an aggregator.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# AI web search (Serper) — an alternative source that is NOT a jobs API, so it's
# unaffected by JSearch limits. It fetches real Google results for job boards and
# the AI structures them into postings (it never invents jobs). Free signup grants
# a one-time credit allowance, no card: https://serper.dev
SERPER_API_KEY=
# How many search results to structure per location per scan.
AI_WEB_RESULTS=10

# Which providers are active (comma separated): jsearch, adzuna, bundesagentur, ai_web
# Run several at once — results are merged and de-duplicated.
ACTIVE_PROVIDERS=jsearch,bundesagentur

# --- Search configuration ---
# Germany-wide by default. Set a city/region to narrow (e.g. "Berlin"), or a
# comma-separated list to search several — each is queried and results merge +
# de-duplicate. Supports "remote"/"online". E.g. SEARCH_LOCATION=remote, Berlin
SEARCH_LOCATION=Germany
# Distance in km around the location (Adzuna supports this).
SEARCH_DISTANCE_KM=50
# Comma-separated keywords. Leave empty to derive from the CV automatically.
SEARCH_KEYWORDS=
# Max results to pull per scan.
MAX_RESULTS=50

# --- Exclusions (comma-separated, case-insensitive substring match) ---
# A job is dropped during a scan if it matches ANY of these. All optional.
EXCLUDE_COMPANIES=
EXCLUDE_LOCATIONS=
EXCLUDE_TITLE_KEYWORDS=
EXCLUDE_DESCRIPTION_KEYWORDS=
EXCLUDE_SOURCES=

# --- App ---
# Where your CV lives. Set a DIRECTORY (default: data) to auto-scan it for CV
# files (pdf, docx, txt, md) and pick from them in the dashboard, or set a
# specific FILE (e.g. data/cv.pdf) to pin one. Parsed into a structured profile.
CV_PATH=data
# Minimum relevance score (0-100) to show a job as a match. The no-AI heuristic
# scores conservatively, so keep this lower (~20) when running without an
# OpenAI key; raise it (~40) once AI scoring is enabled for sharper matches.
MIN_RELEVANCE=20
# Logging verbosity: DEBUG (most verbose), INFO (default), WARNING, ERROR.
LOG_LEVEL=INFO

# --- AI token budget (lower = cheaper OpenAI usage) ---
# AI_SCORE=false is the cheapest option: scanning uses only the free heuristic
# score and spends ZERO OpenAI tokens — tokens are used solely when you apply
# (tailored CV + letter). Set true to let AI score jobs during scan.
AI_SCORE=true
# Scoring runs once per new job and is the biggest spender. With prefilter on,
# the app cheaply heuristic-scores all jobs and only spends AI tokens on the
# top N; the rest keep their heuristic score. (Ignored when AI_SCORE=false.)
AI_PREFILTER=true
AI_SCORE_TOP_N=10
# Characters of text sent to the model (truncation). Trim to spend less.
AI_SCORE_DESC_CHARS=1500
AI_PARSE_CV_CHARS=8000
AI_GEN_DESC_CHARS=2500
AI_GEN_CV_CHARS=8000
AI_GEN_LETTER_CV_CHARS=3500
# Response length caps (tokens).
AI_MAX_TOKENS_JSON=700
AI_MAX_TOKENS_TEXT=1200
