[Unit]
Description=Job Hunter web app
# Start after the network + Ollama. NOT ordered after the update service on
# purpose: a slow/failed boot-time update must never block the app from starting.
# (job-hunter-update runs independently at boot via its own WantedBy.)
Wants=network-online.target
After=network-online.target ollama.service

[Service]
Type=simple
# These are replaced by deploy/setup.sh with the real user/paths at install time.
User=__USER__
WorkingDirectory=__APP_DIR__
# Listen on all interfaces so the UI is reachable from the LAN (phone/laptop).
Environment=HOST=0.0.0.0
Environment=PORT=8000
ExecStart=__APP_DIR__/.venv/bin/python __APP_DIR__/run.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
